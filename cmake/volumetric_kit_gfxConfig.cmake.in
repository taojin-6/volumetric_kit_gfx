@PACKAGE_INIT@

# Re-find the PUBLIC dependencies. VMA + tinygltf are PRIVATE implementation
# details (header-only, each implemented in one library TU), so they are
# deliberately absent here. find_dependency(Vulkan) also re-supplies the loader
# (Vulkan::Vulkan) our static archive links privately.
include(CMakeFindDependencyMacro)
find_dependency(Vulkan)

# Threads is a PRIVATE dependency of gfx_pipelines (the IBL bake's std::async),
# but a static archive still needs the flag/library at consumer link time.
find_dependency(Threads)

# glm is a PUBLIC dependency of the camera and assets tiers (their public headers
# name glm types), so the installed package re-finds it. The vendored build-from-
# source copy is not re-exported, so consuming an installed package requires a
# discoverable glm.
find_dependency(glm)

# spirv-cross is a PRIVATE dependency of gfx_core (SPIR-V reflection in
# shader.cpp). Unlike VMA/tinygltf -- header-only and compiled into a gfx_core
# TU -- spirv-cross is a separate static archive, so gfx_core's own archive
# still references its symbols at consumer link time. It self-installs under
# VG_INSTALL, so the package re-finds the vendored copy here.
find_dependency(spirv_cross_core)

include("${CMAKE_CURRENT_LIST_DIR}/volumetric_kit_gfxTargets.cmake")

check_required_components(volumetric_kit_gfx)
