@PACKAGE_INIT@

# Re-find the PUBLIC dependencies. tinygltf is a PRIVATE implementation detail
# (header-only, implemented in one library TU), so it is deliberately absent
# here, and VMA is the core's, compiled into its allocator. find_dependency(Vulkan) also re-supplies the loader
# (Vulkan::Vulkan) our static archive links privately.
include(CMakeFindDependencyMacro)
# volumetric_kit_core is PUBLIC (Status / Result / the log sink in every tier's
# signatures, and the vulkan tier's types and Vulkan umbrella), at the minor
# version this package was built against. The prefix this package is installed
# in is the hint, as gfx's install carries the core beside it; CMAKE_PREFIX_PATH
# still takes precedence.
find_dependency(volumetric_kit_core @VG_VKC_MAJOR_MINOR@ CONFIG HINTS
                "${PACKAGE_PREFIX_DIR}")
# The core's version does not advance between commits, so a core found on
# CMAKE_PREFIX_PATH may lack the vulkan tier, or predate the timeline-value
# checks gfx's frame loop calls (core::TimelineWaits in sync.hpp, the newest
# declaration gfx needs from it).
set(_vg_vkc_found FALSE)
if(TARGET volumetric_kit::core_vulkan)
  get_target_property(_vg_vkc_includes volumetric_kit::core_vulkan
                      INTERFACE_INCLUDE_DIRECTORIES)
  foreach(_vg_dir IN LISTS _vg_vkc_includes)
    set(_vg_sync "${_vg_dir}/volumetric_kit/core/vulkan/sync.hpp")
    if(EXISTS "${_vg_sync}")
      file(STRINGS "${_vg_sync}" _vg_declares REGEX "^enum class TimelineWaits")
      if(_vg_declares)
        set(_vg_vkc_found TRUE)
      endif()
    endif()
  endforeach()
endif()
if(NOT _vg_vkc_found)
  set(volumetric_kit_gfx_FOUND FALSE)
  string(
    CONCAT volumetric_kit_gfx_NOT_FOUND_MESSAGE
           "gfx needs volumetric_kit_core's vulkan tier at @VG_VKC_PIN@ or "
           "newer; the core at ${volumetric_kit_core_DIR} was built without "
           "the tier (VKC_WITH_VULKAN OFF) or predates that commit")
  return()
endif()
find_dependency(Vulkan)

# Threads is a PRIVATE dependency of gfx_pipelines (the IBL bake's std::async),
# but a static archive still needs the flag/library at consumer link time.
find_dependency(Threads)

# glm is a PUBLIC dependency of the camera and assets tiers (their public headers
# name glm types), so the installed package re-finds it. The vendored build-from-
# source copy is not re-exported, so consuming an installed package requires a
# discoverable glm.
find_dependency(glm)

# spirv-cross is a PRIVATE dependency of gfx_core (SPIR-V reflection in
# shader.cpp). Unlike tinygltf -- header-only and compiled into a gfx TU --
# spirv-cross is a separate static archive, so gfx_core's own archive
# still references its symbols at consumer link time. It self-installs under
# VG_INSTALL, so the package re-finds the vendored copy here.
find_dependency(spirv_cross_core)

include("${CMAKE_CURRENT_LIST_DIR}/volumetric_kit_gfxTargets.cmake")

check_required_components(volumetric_kit_gfx)
