# Plain Google base, 80-column lines, left-aligned pointers, preserved include
# blocks.
Language: Cpp
BasedOnStyle: Google
ColumnLimit: 80
IncludeBlocks: Preserve
DerivePointerAlignment: false
PointerAlignment: Left
---
# The same for Objective-C++ (tests/metal_surface_test.mm), which clang-format
# refuses without a section of its own.
Language: ObjC
BasedOnStyle: Google
ColumnLimit: 80
IncludeBlocks: Preserve
DerivePointerAlignment: false
PointerAlignment: Left
